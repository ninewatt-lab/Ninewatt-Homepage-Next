# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 git에 올라가지 않는다.
# 전부 서버 전용 변수다 (NEXT_PUBLIC_ 접두어 없음 = 런타임에 읽힘, 재빌드 불필요).

# ── 알림·API ────────────────────────────────────────────────
# Teams (Power Automate) Webhook — 문의 폼·챗봇 리드 알림
TEAMS_WEBHOOK_URL=

# Anthropic API — 챗봇
ANTHROPIC_API_KEY=

# ── 검색엔진 소유확인 ──────────────────────────────────────
# 값을 넣으면 [locale]/layout.tsx가 <meta> 태그를 렌더한다.
# 비워두면 태그를 아예 출력하지 않는다(빈 태그 방지).

# 네이버 서치어드바이저 > 사이트 관리 > 소유확인 > HTML 태그
#   <meta name="naver-site-verification" content="여기_값만"/>
#   content 안의 문자열만 넣는다. 태그 전체를 넣으면 안 된다.
NAVER_SITE_VERIFICATION=

# Google Search Console — "URL 접두어" 속성의 HTML 태그 방식일 때만 필요.
#   "도메인" 속성(권장)은 DNS TXT로 확인하므로 이 변수가 필요 없다.
#   자세한 판단 기준: docs/seo-geo-execution-plan.md Sprint 0
GOOGLE_SITE_VERIFICATION=

# ── 콘텐츠 시트 ────────────────────────────────────────────
# 미디어(뉴스·영상) 목록을 담은 Google Sheet의 게시용 CSV 주소.
#   시트에서 파일 > 공유 > 웹에 게시 > (해당 시트) + 쉼표로 구분된 값(.csv) > 게시
#   .../pub?gid=0&single=true&output=csv 형태의 URL이 나온다.
# 비워두면 src/data/media.ts 의 정적 데이터를 그대로 쓴다(로컬 개발 기본값).
# 시트 서식과 운영 방법: docs/content-sheet-guide.md
MEDIA_SHEET_CSV_URL=

# 시트 수정 후 즉시 반영할 때 쓰는 캐시 무효화 시크릿.
#   /api/revalidate?tag=media&secret=<값>
# 설정하지 않으면 해당 엔드포인트가 503을 반환한다(자동 재검증은 계속 동작).
#   openssl rand -hex 24  로 생성
REVALIDATE_SECRET=
